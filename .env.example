# Copy to .env on the server. Never expose this key in a VITE_ variable.
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-2

# Optional private MCP bridge. The file contains the teacher's scoped 24-hour
# image token, never a ChatGPT password/cookie or OpenAI API key. chmod 600 on
# macOS/Linux; on Windows restrict its ACL to the account running the bridge.
# FREE_IMPRO_IMAGE_TOKEN_FILE=data/image-mcp/teacher.token
# FREE_IMPRO_DB=data/classroom.sqlite
# Tunnel runtime credentials are configured locally with the official client,
# separately from OPENAI_API_KEY; do not put them in VITE_ variables.

# Production LAN classroom: npm run setup:https, then npm run classroom.
# HTTPS_PORT=8443
# HTTPS_SETUP_PORT=8080
# HTTPS_CERT_DIR=data/https
# Windows: optional full path to OpenSSL (Git for Windows is auto-detected).
# OPENSSL_BIN=C:\Program Files\Git\usr\bin\openssl.exe
