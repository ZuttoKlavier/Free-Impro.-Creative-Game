# Copy to .env on the server. Never expose this key in a VITE_ variable.
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-2

# Student identity: password works without third-party credentials.
# A persistent local random secret is generated in SQLite if this is unset.
# Set a stable random secret (at least 32 characters) for cloud deployment.
# STUDENT_AUTH_SECRET=
# STUDENT_AUTH_ORIGIN=https://class.empfreeimpro.xyz
# WeChat Open Platform Website Application, approved callback domain required.
# WECHAT_APP_ID=
# WECHAT_APP_SECRET=
# Apple Service ID, Team ID, Sign in with Apple key and server-only .p8 path.
# APPLE_CLIENT_ID=
# APPLE_TEAM_ID=
# APPLE_KEY_ID=
# APPLE_PRIVATE_KEY_FILE=/absolute/private/AuthKey.p8
# Aliyun China SMS: approved sign/template with a code parameter.
# ALIYUN_SMS_ACCESS_KEY_ID=
# ALIYUN_SMS_ACCESS_KEY_SECRET=
# ALIYUN_SMS_SIGN_NAME=
# ALIYUN_SMS_TEMPLATE_CODE=

# Optional private MCP bridge. The file contains the teacher's scoped 24-hour
# image token, never a ChatGPT password/cookie or OpenAI API key. chmod 600 on
# macOS/Linux; on Windows restrict its ACL to the account running the bridge.
# FREE_IMPRO_IMAGE_TOKEN_FILE=data/image-mcp/teacher.token
# FREE_IMPRO_DB=data/classroom.sqlite
# Tunnel runtime credentials are configured locally with the official client,
# separately from OPENAI_API_KEY; do not put them in VITE_ variables.

# Production LAN classroom: npm run setup:https, then npm run classroom.
# HTTPS_PORT=8443
# HTTPS_SETUP_PORT=8080
# HTTPS_CERT_DIR=data/https
# Windows: optional full path to OpenSSL (Git for Windows is auto-detected).
# OPENSSL_BIN=C:\Program Files\Git\usr\bin\openssl.exe
