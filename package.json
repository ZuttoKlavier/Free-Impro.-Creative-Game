{
  "name": "free-impro-student",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "classroom:background": "node scripts/classroom-service.js start",
    "classroom:status": "node scripts/classroom-service.js status",
    "classroom:stop": "node scripts/classroom-service.js stop",
    "mcp:images": "node scripts/image-mcp.js",
    "mcp:images:check": "node scripts/image-mcp.js --check",
    "mcp:images:configure": "node scripts/image-mcp.js --configure",
    "prepare:ios": "node scripts/prepare-ios.js",
    "dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "node --test tests/*.test.js",
    "test:browser": "playwright test",
    "test:offline": "npm run build && playwright test --config playwright.offline.config.js",
    "test:https": "npm run build && playwright test --config playwright.https.config.js",
    "server": "node server/index.js",
    "start": "node scripts/dev.js",
    "setup:https": "node scripts/setup-https.js",
    "classroom": "npm run build && node server/classroom.js",
    "teacher:desktop": "node scripts/teacher-desktop.js",
    "package:teacher:mac": "node scripts/teacher-desktop.js package darwin arm64",
    "package:teacher:windows": "node scripts/teacher-desktop.js package win32 x64",
    "test:desktop": "npm run build && playwright test --config playwright.desktop.config.js"
  },
  "devDependencies": {
    "@electron/packager": "^20.3.0",
    "@playwright/test": "^1.55.0",
    "electron": "^44.4.5",
    "fake-indexeddb": "^6.2.0",
    "vite": "^7.1.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "dexie": "4.4.6",
    "openai": "7.27.0",
    "pngjs": "^7.0.0",
    "qrcode": "^1.5.4",
    "wavesurfer.js": "8.0.1",
    "zod": "^3.25.76"
  },
  "engines": {
    "node": ">=24.15.0"
  }
}
